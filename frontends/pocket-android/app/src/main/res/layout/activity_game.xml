<?xml version="1.0" encoding="utf-8"?>
<!--
    Layout for the in-game screen: framebuffer on top (with a
    progress spinner overlay until the first frame arrives), a
    j2me-loader-inspired virtual gamepad in the middle (D-pad on
    the left, action / soft-key cluster on the right), and a thin
    status panel at the bottom that shows the textual summary the
    Rust runner emits when the emulator exits. The button IDs
    referenced here are wired up in `GameActivity.wireVirtualGamepad`.
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_launcher_gradient"
    android:orientation="vertical">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:background="@drawable/bg_today_titlebar"
        android:theme="@style/ThemeOverlay.PocketHLE.AppBar"
        app:popupTheme="@style/ThemeOverlay.PocketHLE.AppBar" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@android:color/black">

        <android.opengl.GLSurfaceView
            android:id="@+id/surface"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <TextView
            android:id="@+id/fps_overlay"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_margin="8dp"
            android:background="#B0000000"
            android:fontFamily="monospace"
            android:padding="6dp"
            android:text="FPS 0"
            android:textColor="#00FF00"
            android:textSize="14sp"
            android:visibility="gone" />

        <ProgressBar
            android:id="@+id/progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center" />
    </FrameLayout>

    <!--
        Virtual gamepad. Layout mirrors the j2me-loader phone-style
        skin: D-pad on the left half, action + soft buttons on the
        right half. The buttons are plain text Buttons styled with
        a circular background to keep the APK small (no PNG assets
        required).
    -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_xp_panel"
        android:orientation="horizontal"
        android:padding="10dp">

        <!--
            D-pad cluster. The buttons are laid out in three rows so
            the directional controls read more like a physical pad:
            up on top, left/right in the middle, down at the bottom.
            The container keeps enough height to preserve that shape.
        -->
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.15"
            android:minHeight="176dp"
            android:padding="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical">

                <Button
                    android:id="@+id/btn_up"
                    style="@null"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginBottom="8dp"
                    android:background="@drawable/bg_gamepad_button"
                    android:backgroundTint="@null"
                    android:contentDescription="@string/dpad_up"
                    android:includeFontPadding="false"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:stateListAnimator="@null"
                    android:text="@string/dpad_up_glyph"
                    android:textColor="#FFFFFFFF"
                    android:textSize="19sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btn_left"
                        style="@null"
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:layout_marginEnd="18dp"
                        android:background="@drawable/bg_gamepad_button"
                        android:backgroundTint="@null"
                        android:contentDescription="@string/dpad_left"
                        android:includeFontPadding="false"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:stateListAnimator="@null"
                        android:text="@string/dpad_left_glyph"
                        android:textColor="#FFFFFFFF"
                        android:textSize="19sp" />

                    <View
                        android:layout_width="24dp"
                        android:layout_height="1dp" />

                    <Button
                        android:id="@+id/btn_right"
                        style="@null"
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:layout_marginStart="18dp"
                        android:background="@drawable/bg_gamepad_button"
                        android:backgroundTint="@null"
                        android:contentDescription="@string/dpad_right"
                        android:includeFontPadding="false"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:stateListAnimator="@null"
                        android:text="@string/dpad_right_glyph"
                        android:textColor="#FFFFFFFF"
                        android:textSize="19sp" />
                </LinearLayout>

                <Button
                    android:id="@+id/btn_down"
                    style="@null"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_gamepad_button"
                    android:backgroundTint="@null"
                    android:contentDescription="@string/dpad_down"
                    android:includeFontPadding="false"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:stateListAnimator="@null"
                    android:text="@string/dpad_down_glyph"
                    android:textColor="#FFFFFFFF"
                    android:textSize="19sp" />
            </LinearLayout>
        </FrameLayout>

        <!-- Action / soft-key cluster. -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="0.95"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="6dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_soft1"
                    style="@null"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:layout_marginEnd="10dp"
                    android:background="@drawable/bg_gamepad_button"
                    android:includeFontPadding="false"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:backgroundTint="@null"
                    android:stateListAnimator="@null"
                    android:text="@string/soft1_label"
                    android:textColor="#10233E"
                    android:textSize="15sp" />

                <Button
                    android:id="@+id/btn_soft2"
                    style="@null"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:layout_marginStart="10dp"
                    android:background="@drawable/bg_gamepad_button"
                    android:includeFontPadding="false"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:backgroundTint="@null"
                    android:stateListAnimator="@null"
                    android:text="@string/soft2_label"
                    android:textColor="#10233E"
                    android:textSize="15sp" />
            </LinearLayout>

            <Button
                android:id="@+id/btn_action"
                style="@null"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_gamepad_button_action"
                android:contentDescription="@string/action_button"
                android:includeFontPadding="false"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:backgroundTint="@null"
                android:stateListAnimator="@null"
                android:text="@string/action_button_glyph"
                android:textColor="#FFFFFFFF"
                android:textSize="22sp" />
            <Button
                android:id="@+id/btn_turbo"
                style="@null"
                android:layout_width="104dp"
                android:layout_height="40dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_gamepad_button_pill"
                android:contentDescription="@string/turbo_button"
                android:includeFontPadding="false"
                android:letterSpacing="0.05"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:backgroundTint="@null"
                android:stateListAnimator="@null"
                android:text="@string/turbo_button_label"
                android:textColor="#FFFFFFFF"
                android:textSize="13sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_a"
                    style="@null"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_gamepad_button"
                    android:includeFontPadding="false"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:backgroundTint="@null"
                    android:stateListAnimator="@null"
                    android:text="@string/key_a_label"
                    android:textColor="#10233E"
                    android:textSize="16sp" />

                <Button
                    android:id="@+id/btn_b"
                    style="@null"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:layout_marginHorizontal="6dp"
                    android:background="@drawable/bg_gamepad_button"
                    android:includeFontPadding="false"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:backgroundTint="@null"
                    android:stateListAnimator="@null"
                    android:text="@string/key_b_label"
                    android:textColor="#10233E"
                    android:textSize="16sp" />

                <Button
                    android:id="@+id/btn_c"
                    style="@null"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_gamepad_button"
                    android:includeFontPadding="false"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:backgroundTint="@null"
                    android:stateListAnimator="@null"
                    android:text="@string/key_c_label"
                    android:textColor="#10233E"
                    android:textSize="16sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurface"
        android:fontFamily="monospace"
        android:maxLines="6"
        android:padding="8dp"
        android:scrollbars="vertical"
        android:textColor="?android:attr/textColorPrimary"
        android:textSize="12sp" />
</LinearLayout>
