<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="6dp"
    android:background="@drawable/bg_wm_row"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="8dp">

    <ImageView
        android:id="@+id/game_icon"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="@color/grid_icon_bg"
        android:contentDescription="@string/game_icon"
        android:padding="4dp"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_game" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/game_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/md_on_surface"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/game_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/md_on_surface_variant"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/game_backend"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/md_on_surface_variant"
            android:textSize="11sp" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/btn_more"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:background="@drawable/bg_card_overflow"
        android:contentDescription="@string/action_more"
        android:padding="4dp"
        android:src="@drawable/ic_more_vert" />
</LinearLayout>
